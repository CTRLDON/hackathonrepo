# Copy to .env and adjust. Never commit .env. Placeholder values only.
# Open-weight model served locally by Ollama (docker compose starts it for you).
MODEL_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT=180
OLLAMA_MAX_RETRIES=2
OLLAMA_TEMPERATURE=0.7

# How many agents may call the model at once
MAX_CONCURRENT_AGENTS=2

# Web server
HOST=0.0.0.0
PORT=8000

# scripts/run_demo.py: per-stage timeout in seconds
DEMO_STAGE_TIMEOUT=300
